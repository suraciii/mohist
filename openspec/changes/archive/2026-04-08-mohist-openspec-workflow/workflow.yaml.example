# workflow.yaml - Mohist OpenSpec Workflow (Default)
#
# This is the default workflow for Mohist with OpenSpec integration.
# It provides a 4-stage workflow for structured changes:
# plan → review → build → check
#
# Features:
# - Plan stage: Generates Change artifacts with self-review (max 3 iterations)
# - Review stage: Human approval gate for Change review
# - Build stage: Ralph-style task loop execution
# - Check stage: Automated testing + human acceptance + archival
#
# Usage:
#   mo propose <issue-number>     # Create/update Change for an issue
#   mo issue start <id>           # Start workflow (auto-detects OpenSpec vs traditional)
#   mo issue resume <id>          # Resume paused workflow

stages:
  # ═══════════════════════════════════════════════════════════════════════
  # STAGE 1: PLAN - Generate Change artifacts with self-review
  # ═══════════════════════════════════════════════════════════════════════
  - stage: plan
    prompt: |
      ## OpenSpec Plan Stage
      
      Issue: #{issue.number} {issue.title}
      Issue Body: {issue.body}
      
      Your task is to explore the codebase and generate a complete Change proposal.
      
      ### Step 1: Explore Codebase
      - Read the issue description carefully
      - Explore relevant code files and directories
      - Understand existing patterns and conventions
      - Identify dependencies and integration points
      
      ### Step 2: Create Change Directory
      Create: `.mohist-specs/changes/{issue.number}-{slug}/`
      
      ### Step 3: Generate Artifacts
      Create the following files:
      
      **proposal.md** - Change Proposal
      - Why: Why this change is needed
      - What: What will be changed
      - Impact: Scope and affected areas
      
      **design.md** - Technical Design
      - Context: Current state analysis
      - Goals: What we're achieving
      - Non-Goals: What's out of scope
      - Decisions: Key technical decisions
      - Risks: Potential issues and mitigations
      
      **specs/*.md** - Detailed Specifications
      - One file per capability
      - Clear requirements with acceptance criteria
      
      ### Step 4: Self-Review (Max 3 iterations)
      Review the generated artifacts:
      1. Are all specs complete with AC?
      2. Does design cover edge cases?
      3. Are requirements clear and testable?
      
      If issues found, fix them and review again.
      If no improvement after 3 iterations, pause for human intervention.
      
      ### Step 5: Generate prd.json
      Create the task breakdown in prd.json format.
      
      ### Completion
      When done, call `advance_stage` to move to review.
    
    approval: false
    timeout: 1200  # 20 minutes (includes self-review iterations)

  # ═══════════════════════════════════════════════════════════════════════
  # STAGE 2: REVIEW - Human approval gate for Change review
  # ═══════════════════════════════════════════════════════════════════════
  - stage: review
    prompt: |
      ## OpenSpec Review Stage
      
      The Change proposal has been generated and is ready for review.
      
      Location: `.mohist-specs/changes/{issue.number}-{slug}/`
      
      ### Files to Review
      1. **proposal.md** - Change motivation and scope
      2. **design.md** - Technical approach and decisions
      3. **specs/*.md** - Detailed requirements and AC
      4. **prd.json** - Task breakdown
      
      ### Your Actions
      You can:
      - Edit any file directly to improve it
      - Add comments to the issue with feedback
      - Call `advance_stage` to proceed to build when satisfied
      
      ### Approval Gate
      This stage requires your approval before proceeding.
      The build will not start until you explicitly continue.
    
    approval: true
    timeout: 600  # 10 minutes (or indefinite until user approves)

  # ═══════════════════════════════════════════════════════════════════════
  # STAGE 3: BUILD - Ralph-style task loop execution
  # ═══════════════════════════════════════════════════════════════════════
  - stage: build
    prompt: |
      ## OpenSpec Build Stage - Ralph Loop
      
      Execute tasks from prd.json one by one.
      
      Change Location: `.mohist-specs/changes/{issue.number}-{slug}/`
      PRD: `{change.path}/prd.json`
      
      ### Ralph Loop Process
      
      For each task in prd.json:
      
      1. **Read Task**
         - Get task description and AC
         - Identify dependencies
      
      2. **Assemble Context**
         - proposal.md (background)
         - design.md (constraints)
         - specs/{capability}.md (current requirement)
         - session-memories/*.json (learnings from previous tasks)
         - task description + AC
      
      3. **Execute Task**
         - Call `spawn_coder` with assembled context
         - Wait for completion
      
      4. **Verify AC**
         - Check if acceptance criteria are met
         - Run tests if applicable
      
      5. **Handle Result**
         - **Success**: Store learning, update task-status.json, continue to next task
         - **AC/Env Failure**: Retry up to max attempts with failure context in prompt
         - **Dependency/Timeout**: Pause and ask user
      
      6. **Store Learning**
         - Extract insights (patterns discovered)
         - Record adjustments (advice for future tasks)
         - Save to `session-memories/{task-id}.json`
      
      ### Failure Recovery
      
      If a task fails:
      - AC/Environment issues: Retry (max 3 total attempts)
      - Code dependency issues: Pause, ask user for guidance
      - Timeout: Pause, ask if task should be split
      
      When retrying, include previous failure context in the prompt.
      
      ### Resume Support
      
      If build is paused and resumed:
      - Read `task-status.json` to find current task
      - Load previous learnings
      - Continue from where it left off
      
      ### Completion
      When all tasks complete, call `advance_stage` to move to check.
    
    approval: false
    timeout: 3600  # 60 minutes (complex builds)

  # ═══════════════════════════════════════════════════════════════════════
  # STAGE 4: CHECK - Automated testing + human acceptance + archival
  # ═══════════════════════════════════════════════════════════════════════
  - stage: check
    prompt: |
      ## OpenSpec Check Stage
      
      Final validation and acceptance.
      
      ### Step 1: Automated Testing
      Run the following commands:
      - `npm test` (or project-specific test command)
      - `npm run lint` (or project-specific lint command)
      
      Report results in an issue comment.
      
      ### Step 2: Verification
      Verify:
      - All prd.json tasks show as "completed"
      - All acceptance criteria are satisfied
      - Tests pass
      - Code quality checks pass
      
      ### Step 3: Human Acceptance (Approval Gate)
      Wait for human review and approval.
      
      User can:
      - Review all changes
      - Approve to complete the issue
      - Request fixes (will loop back to build)
      
      ### Step 4: Archive Change
      When approved:
      1. Move Change directory to `.mohist-specs/archive/YYYY-MM-DD-{name}/`
      2. Generate execution report
      3. Call `advance_stage` to done
      
      The Change artifacts remain accessible in the archive for future reference.
    
    approval: true
    timeout: 600  # 10 minutes (or indefinite until user approves)
