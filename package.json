{
  "name": "mohist-monorepo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19.0",
    "npm": ">=10.0.0"
  },
  "workspaces": [
    "packages/web",
    "packages/runner",
    "packages/mohist-slack"
  ],
  "scripts": {
    "build": "dotnet build Mohist.sln -p:SkipWebBuild=true && concurrently --kill-others-on-fail --names web,runner,slack \"npm run build -w packages/web\" \"npm run build -w packages/runner\" \"npm run build -w packages/mohist-slack\"",
    "test": "tsx scripts/test-duration/command.ts portfolio",
    "test:fast": "tsx scripts/test-duration/command.ts fast",
    "verify": "tsx scripts/test-duration/verify.ts",
    "hooks": "git config --local core.hooksPath \"$(git rev-parse --path-format=absolute --git-common-dir)/../.githooks\"",
    "typecheck:scripts": "tsc -p tsconfig.scripts.json --noEmit",
    "test:archscripts": "tsx --test scripts/*.test.ts scripts/test-duration/*.test.ts",
    "test:app": "tsx scripts/test-duration/application.ts",
    "docs:check": "tsx scripts/check-docs.ts",
    "check:filesizes": "tsx scripts/check-file-sizes.ts",
    "format": "tsx scripts/check-format.ts --write",
    "format:check": "tsx scripts/check-format.ts",
    "archtest": "npm run format:check && npm run check:filesizes && npm run typecheck:scripts && npm run test:archscripts",
    "build:web": "npm run build -w packages/web",
    "build:runner": "npm run build -w packages/runner",
    "dev:runner": "npm run dev -w packages/runner",
    "dev:web": "npm run dev -w packages/web",
    "dev:server": "dotnet run --project packages/server/src/Mohist.Server/Mohist.Server.csproj",
    "dev": "concurrently -n server,web -c blue,green \"npm run dev:server\" \"npm run dev:web\"",
    "install:cli": "dotnet pack packages/cli/Mohist.Cli/Mohist.Cli.csproj -c Release -o ./nupkg && dotnet tool install -g Mohist.Cli --add-source ./nupkg"
  },
  "devDependencies": {
    "@babel/parser": "^7.29.7",
    "@biomejs/biome": "2.5.8",
    "@types/node": "^22.15.0",
    "concurrently": "^9.2.3",
    "github-slugger": "^2.0.0",
    "mdast-util-to-string": "^4.0.0",
    "remark-lint-no-undefined-references": "^5.0.2",
    "remark-parse": "^11.0.0",
    "tsx": "^4.20.0",
    "typescript": "7.0.2",
    "unified": "^11.0.5",
    "vfile": "^6.0.3"
  }
}
