{
  "name": "mohist-monorepo",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build -w packages/cli",
    "test": "npm run test -w packages/cli",
    "lint": "npm run lint -w packages/cli",
    "typecheck": "npm run typecheck -w packages/cli",
    "dev": "concurrently -n server,web -c blue,green \"npm run start:server -w packages/cli\" \"npm run dev:web -w packages/cli\""
  }
}
