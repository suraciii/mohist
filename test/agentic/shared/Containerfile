# test/agentic/shared/Containerfile
#
# Base container for mohist agentic tests (Layer A).
#
# Rebuild from project root:
#   podman build --network=host -t mohist-test -f test/agentic/shared/Containerfile .
#
# Layer B (full pipeline with opencode):
#   cp $(which opencode) test/agentic/shared/bin/opencode
#   podman build -t mohist-walkthrough -f test/agentic/shared/Containerfile.layer2 test/agentic/

FROM node:22.19.0-bookworm AS node-toolchain

FROM mcr.microsoft.com/dotnet/sdk:10.0-preview

RUN apt-get update && \
    apt-get install -y --no-install-recommends git curl python3 make g++ && \
    rm -rf /var/lib/apt/lists/*

COPY --from=node-toolchain /usr/local/ /usr/local/

RUN groupadd -g 1001 motest && useradd -m -u 1001 -g motest motest

WORKDIR /opt/mohist-src

COPY package.json package-lock.json ./
RUN --mount=type=cache,target=/root/.npm \
    npm ci

COPY packages/web/package.json packages/web/package-lock.json packages/web/
RUN --mount=type=cache,target=/root/.npm \
    npm ci -w packages/web

COPY packages/web/ packages/web/
COPY packages/runner/ packages/runner/
COPY packages/server/ packages/server/
RUN npm run build:web
RUN dotnet build Mohist.sln

RUN mkdir -p /app/workspace /home/motest/.mohist/projects /home/motest/.mohist/logs && \
    chown -R motest:motest /app /home/motest

COPY test/agentic/shared/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

USER motest
WORKDIR /app/workspace

EXPOSE 3456
CMD []
ENTRYPOINT ["/entrypoint.sh"]
