# test/agentic/shared/Containerfile
#
# Base container for mohist agentic tests.
#
# This image contains:
#   - node:20-slim + python3/make/g++ (for native modules)
#   - mohist source with npm dependencies and better-sqlite3 rebuilt
#   - motest user (UID 1001)
#   - /app/workspace, /home/motest/.mohist
#   - entrypoint.sh (starts mo-server)
#
# Layer B tests: extend this image, add opencode binary
#   FROM mohist-test
#   COPY test/agentic/shared/bin/opencode /usr/local/bin/opencode
#
# To rebuild from scratch (slow, needs network):
#   1. Start node:20-slim with --network=host
#   2. apt-get install git curl jq python3 make g++
#   3. Copy packages/cli, package.json, package-lock.json, node_modules
#   4. npm rebuild better-sqlite3
#   5. Set up motest user, entrypoint, commit as mohist-test

FROM mohist-test
