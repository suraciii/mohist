{
  // Test-duration policy. Drives scripts/test-duration/guard.ts.
  // See design/testing.md "Test-duration guard" for the full model.
  //
  // Hard constraints per enforced track (all FAIL, never warnings):
  //   - unit:  p95 <= 50ms (population, "most are fast") AND per-test <= 500ms.
  //   - spec:  p95 <= 500ms (population) AND per-test <= 5s (design/testing.md hard cap).
  //   - arch:  per-test <= 500ms only (structural; no p95 — design/testing.md
  //            separates Architecture tests as their own category).
  // A test over its per-test cap FAILS unless listed below as governed
  // governance: identity + observed baseline + reason + owner + removal
  // deadline. p95 cannot be allowlisted away. On the deadline the entry
  // expires and the guard fails until the test is optimized or renewed.
  //
  // Full suite 5-minute deadline (suiteDeadlineMs); per-track hard deadlines
  // via a Node-spawned subprocess kill (cross-platform; never the Linux
  // `timeout` binary as the only executor). Tracks with enforce=false are
  // deadline-governed only (baseline-pending) — explicit status, not a warning.
  //
  // Allowlist entries are real >cap exact identities (no class/glob exemptions).
  "suiteDeadlineMs": 300000,
  "killGraceMs": 5000,
  // The local canonical gate does not open every test process at once. The
  // four-lane host cap matches the active Spec runner bound; resource caps
  // reserve capacity for a Node lane while bounded .NET work is active.
  "canonical": {
    "maxConcurrentLanes": 4,
    "resourceLimits": {
      "host": 4,
      "dotnet": 3,
      "node": 2,
      "server-spec": 3,
      "duration-measurement": 1
    },
    // These duration-sensitive .NET tracks run as a short ordered prefix.
    // Runner then gates only the remaining Node lanes while .NET fan-out stays
    // bounded and concurrent.
    "durationMeasurementTracks": ["cli", "server-unit"],
    "durationIsolationTrack": "runner"
  },
  "tracks": [
    { "id": "mohist-slack", "kind": "vitest", "run": ["npm","run","test:duration","-w","packages/mohist-slack","--","--reporter=json","--outputFile={report}"], "report": "reports/mohist-slack.json", "reportFormat": "vitest", "deadlineMs": 30000, "enforce": true, "rules": [
        { "id": "unit", "absoluteMs": 500, "percentile": 95, "percentileMs": 50, "allowlist": [] }
      ]
    },
    { "id": "runner", "kind": "vitest", "run": ["npm","run","test:duration","-w","packages/runner","--","--reporter=json","--outputFile={report}"], "report": "reports/runner.json", "reportFormat": "vitest", "deadlineMs": 90000, "enforce": true, "rules": [
        { "id": "unit", "absoluteMs": 500, "percentile": 95, "percentileMs": 50, "allowlist": [
          { "id": "RunnerHost idle-system cleanup FetchesConfigOnEachCleanupTick_AndRunsEviction_WhenPollStays204", "observedMs": 1041.8, "reason": "cleanup tick runs eviction against a poll-stays-204 path; optimize or move behind a fake clock signal", "owner": "runner", "deadline": "2026-09-30" }
          ] }
      ]
    },
    { "id": "workflow-def", "kind": "dotnet-vstest", "csproj": "packages/server/tests/Mohist.Workflow.Definition.Tests/Mohist.Workflow.Definition.Tests.csproj", "report": "reports/workflow-def.trx", "reportFormat": "trx", "deadlineMs": 30000, "enforce": true, "rules": [
        { "id": "unit", "absoluteMs": 500, "percentile": 95, "percentileMs": 50, "allowlist": [] }
      ]
    },
    // Four collection workers retain parallelism without letting concurrent cold command-tree construction dominate native test execution time.
    { "id": "cli", "kind": "dotnet-apphost", "csproj": "packages/cli/tests/Mohist.Cli.Tests/Mohist.Cli.Tests.csproj", "apphostArgs": ["-preEnumerateTheories", "-parallel", "collections", "-parallelAlgorithm", "conservative", "-maxThreads", "4"], "report": "reports/cli.trx", "executionLedger": "reports/cli.execution-ledger.json", "executionProvenance": "reports/cli.execution-provenance.json", "executionSourceRoots": ["packages/cli", "Directory.Build.props", "Directory.Packages.props", "global.json"], "reportFormat": "trx", "deadlineMs": 60000, "enforce": true, "rules": [
        { "id": "spec", "namePattern": "Specs\\.", "absoluteMs": 5000, "percentile": 95, "percentileMs": 500, "allowlist": [] },
        { "id": "unit", "absoluteMs": 500, "percentile": 95, "percentileMs": 50, "allowlist": [] }
      ]
    },
    { "id": "web", "kind": "vitest", "run": ["npm","run","test:duration","-w","packages/web","--","--reporter=json","--outputFile={report}"], "report": "reports/web.json", "reportFormat": "vitest", "deadlineMs": 180000, "enforce": false, "status": "baseline-pending", "reason": "large suite; ratchet pending a baseline capture run"
    },
