          { "id": "Mohist.Server.UnitTests.Agent.Services.ProjectRecentEventReaderTests.ListAsyncFiltersProjectOrdersNewestFirstAndBoundsResults", "observedMs": 2034.2, "reason": "test over 500ms absolute cap; optimize or split", "owner": "server", "deadline": "2026-09-30" },
