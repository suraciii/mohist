{
  // Test-duration policy. Drives scripts/test-duration/guard.ts.
  // See scripts/test-duration/README.md for the gate implementation model.
  //
  // Hard constraints per enforced budget rule (all FAIL, never warnings):
  //   - L0: p95 <= 50ms for the complete track population.
  //   - L1: p95 <= 500ms for the complete track population.
  //   - architecture: the track deadline bounds total structural-check cost.
  // The rule ids below are execution adapters. They do not classify the Spec.
  //
  // Full suite seven-minute deadline (suiteDeadlineMs); per-track hard deadlines
  // via a Node-spawned subprocess kill (cross-platform; never the Linux
  // `timeout` binary as the only executor). Tracks with enforce=false are
  // migration gaps (baseline-pending), not warnings.
  //
  "suiteDeadlineMs": 420000,
  "killGraceMs": 5000,
  // The local executor does not open every test process at once. The
  // Resource caps reserve capacity for a Node lane while bounded .NET work is active.
  "canonical": {
    "maxConcurrentLanes": 4,
    "resourceLimits": {
      "host": 4,
      "dotnet": 4,
      "node": 2,
      "server-l1": 1,
      "server-runtime": 1,
      "duration-measurement": 1
    },
    // The isolated Server measurement precedes the remaining fan-out.
    "durationMeasurementTracks": ["server-l1"],
    "durationIsolationTrack": "runner"
  },
  "plan": {
    "applications": ["server", "web", "runner"],
    "repositoryScope": "repository",
    "applicationBuilds": {
      "server": [
        { "command": "dotnet", "args": ["build", "Mohist.Server.Tests.slnf", "-p:SkipWebBuild=true"] }
      ],
      "web": [
        { "command": "npm", "args": ["run", "build", "-w", "packages/web"] }
      ],
      "runner": [
        { "command": "npm", "args": ["run", "build", "-w", "packages/runner"] }
      ]
    },
    "repositoryChecks": [
      { "command": "npm", "args": ["run", "docs:check"] },
      { "command": "npm", "args": ["run", "archtest"] },
      { "command": "npm", "args": ["run", "build:slack"] },
      { "command": "npm", "args": ["run", "build:cli"] },
      { "command": "npm", "args": ["run", "check:cli-go-format"] },
      { "command": "npm", "args": ["run", "test:cli"] },
      { "command": "go", "args": ["-C", "packages/go/mohist-slack", "vet", "./..."] },
      { "command": "go", "args": ["-C", "packages/go/mohist-slack", "test", "./..."] }
    ],
    "fastChecks": [
      { "command": "npm", "args": ["run", "typecheck:scripts"] }
    ],
    "resourceLanes": [
      { "id": "default", "resources": [], "capacity": 4 },
      { "id": "server-l1", "resources": ["orleans", "sqlite", "server-runtime"], "capacity": 1 },
      { "id": "server-l0", "resources": ["orleans", "sqlite", "server-runtime", "duration-measurement"], "capacity": 1 },
      { "id": "architecture-measurement", "resources": ["duration-measurement"], "capacity": 1 }
    ]
  },
  "tracks": [
    { "id": "runner", "kind": "vitest", "trackType": "behavior", "application": "runner", "specKinds": ["Design"], "level": "L0", "resources": [], "run": ["npm","run","test:duration","-w","packages/runner","--","--reporter=json","--outputFile={report}"], "report": "reports/runner.json", "reportFormat": "vitest", "deadlineMs": 90000, "enforce": true, "rules": [
        { "id": "unit", "percentile": 95, "percentileMs": 50 }
      ]
    },
    { "id": "web", "kind": "vitest", "trackType": "behavior", "application": "web", "specKinds": ["Product"], "level": "L1", "resources": [], "run": ["npm","run","test:duration","-w","packages/web","--","--reporter=json","--outputFile={report}"], "report": "reports/web.json", "reportFormat": "vitest", "deadlineMs": 180000, "enforce": true, "rules": [
        { "id": "spec", "percentile": 95, "percentileMs": 500 }
      ]
    },
    { "id": "server-l0", "kind": "dotnet-apphost", "trackType": "behavior", "application": "server", "specKinds": ["Design", "Product"], "level": "L0", "resources": ["orleans", "sqlite", "server-runtime", "duration-measurement"], "csproj": "packages/server/tests/Mohist.Server.L0Tests/Mohist.Server.L0Tests.csproj", "apphostArgs": ["-parallel", "collections", "-parallelAlgorithm", "conservative", "-maxThreads", "1"], "report": "reports/server-l0.trx", "reportFormat": "trx", "deadlineMs": 90000, "enforce": true, "rules": [
        { "id": "spec", "namePattern": "(OtelOrleansSourceNameSpecs|RunnerBuildIdentitySpecs|WorkflowRecoveryContinuationSpecs)\\.", "expectedTotal": 4, "percentile": 95, "percentileMs": 50 },
        { "id": "unit", "percentile": 95, "percentileMs": 50 }
      ]
    },
    { "id": "server-arch", "kind": "dotnet-apphost", "trackType": "architecture", "application": "server", "specKinds": ["Design"], "architectureScope": "server", "resources": ["duration-measurement"], "csproj": "packages/server/tests/Mohist.Server.ArchTests/Mohist.Server.ArchTests.csproj", "report": "reports/server-arch.trx", "reportFormat": "trx", "deadlineMs": 60000, "enforce": true, "rules": [
        { "id": "arch" }
      ]
    },
    // A single collection worker keeps the application host and in-process Orleans silo within
    // the shared CI runner's CPU budget. More workers inflate per-Spec wall time into the p95
    // budget; this resource cap is a stability control, not a throughput target.
    { "id": "server-l1", "kind": "dotnet-apphost", "trackType": "behavior", "application": "server", "specKinds": ["Product"], "level": "L1", "resources": ["orleans", "sqlite", "server-runtime"], "csproj": "packages/server/tests/Mohist.Server.L1Tests/Mohist.Server.L1Tests.csproj", "apphostArgs": ["-parallel", "collections", "-parallelAlgorithm", "conservative", "-maxThreads", "1"], "report": "reports/server-l1.trx", "reportFormat": "trx", "deadlineMs": 300000, "enforce": true, "rules": [
        { "id": "spec", "percentile": 95, "percentileMs": 500 }
      ]
    },
    { "id": "runner-integration", "kind": "vitest", "trackType": "behavior", "application": "runner", "specKinds": ["Product"], "level": "L1", "resources": [], "run": ["npm","run","test:duration:integration","-w","packages/runner","--","--reporter=json","--outputFile={report}"], "report": "reports/runner-integration.json", "reportFormat": "vitest", "deadlineMs": 90000, "enforce": true, "rules": [
        { "id": "spec", "percentile": 95, "percentileMs": 500 }
      ]
    }
  ]
}
