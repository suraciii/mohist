          { "id": "Mohist.Server.UnitTests.Workflow.Storage.DispatchSnapshotStoreTests.SaveFirstAsync_OnSecondCallForSameAttempt_ReturnsFirstStoredUnchanged", "observedMs": 754.8, "reason": "test over 500ms absolute cap; optimize or split", "owner": "server", "deadline": "2026-09-30" },
          { "id": "Mohist.Server.UnitTests.Slack.SlackThreadLaunchReservationStoreTests.ReserveAsync_AllowsOnlyOneLaunchAndRecognizesRedelivery", "observedMs": 688.7, "reason": "test over 500ms absolute cap; optimize or split", "owner": "server", "deadline": "2026-09-30" },
