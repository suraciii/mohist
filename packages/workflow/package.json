{
  "name": "@mohist/workflow",
  "version": "0.1.0",
  "description": "Pure workflow definition, domain model, and orchestration contracts for Mohist.",
  "main": "dist/index.js",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./domain": {
      "types": "./src/domain/index.ts",
      "default": "./dist/domain/index.js"
    },
    "./definition": {
      "types": "./src/definition/index.ts",
      "default": "./dist/definition/index.js"
    },
    "./runtime": {
      "types": "./src/runtime/index.ts",
      "default": "./dist/runtime/index.js"
    },
    "./handlers": {
      "types": "./src/handlers/index.ts",
      "default": "./dist/handlers/index.js"
    }
  },
  "typesVersions": {
    "*": {
      "domain": ["src/domain/index.ts"],
      "definition": ["src/definition/index.ts"],
      "runtime": ["src/runtime/index.ts"],
      "handlers": ["src/handlers/index.ts"]
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "license": "MIT",
  "dependencies": {
    "yaml": "^2.8.3"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vitest": "^1.0.4"
  }
}
