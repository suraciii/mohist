{
  "name": "@mohist/workflow",
  "version": "0.1.0",
  "description": "Pure workflow definition, domain model, and orchestration contracts for Mohist.",
  "main": "dist/index.js",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./runtime": {
      "types": "./src/runtime.ts",
      "default": "./dist/runtime.js"
    },
    "./workflows": {
      "types": "./src/workflows.ts",
      "default": "./dist/workflows.js"
    },
    "./workflow-results": {
      "types": "./src/workflow-results.ts",
      "default": "./dist/workflow-results.js"
    },
    "./result-contracts": {
      "types": "./src/result-contracts.ts",
      "default": "./dist/result-contracts.js"
    },
    "./uses-catalog": {
      "types": "./src/uses-catalog.ts",
      "default": "./dist/uses-catalog.js"
    },
    "./internal/model": {
      "types": "./src/model/index.ts",
      "default": "./dist/model/index.js"
    },
    "./internal/model/*": {
      "types": "./src/model/*.ts",
      "default": "./dist/model/*.js"
    },
    "./definition/*": {
      "types": "./src/definition/*.ts",
      "default": "./dist/definition/*.js"
    },
    "./runner/*": {
      "types": "./src/runner/*.ts",
      "default": "./dist/runner/*.js"
    },
    "./reaction/*": {
      "types": "./src/reaction/*.ts",
      "default": "./dist/reaction/*.js"
    },
    "./tasks": {
      "types": "./src/tasks/index.ts",
      "default": "./dist/tasks/index.js"
    },
    "./tasks/*": {
      "types": "./src/tasks/*.ts",
      "default": "./dist/tasks/*.js"
    },
    "./checks": {
      "types": "./src/checks/index.ts",
      "default": "./dist/checks/index.js"
    },
    "./checks/*": {
      "types": "./src/checks/*.ts",
      "default": "./dist/checks/*.js"
    }
  },
  "typesVersions": {
    "*": {
      "definition/*": ["src/definition/*"],
      "runner/*": ["src/runner/*"],
      "reaction/*": ["src/reaction/*"],
      "internal/model": ["src/model/index.ts"],
      "internal/model/*": ["src/model/*"],
      "tasks": ["src/tasks/index.ts"],
      "tasks/*": ["src/tasks/*"],
      "checks": ["src/checks/index.ts"],
      "checks/*": ["src/checks/*"],
      "workflows": ["src/workflows.ts"],
      "runtime": ["src/runtime.ts"],
      "workflow-results": ["src/workflow-results.ts"],
      "result-contracts": ["src/result-contracts.ts"],
      "uses-catalog": ["src/uses-catalog.ts"]
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "license": "MIT",
  "dependencies": {
    "yaml": "^2.8.3"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vitest": "^1.0.4"
  }
}
