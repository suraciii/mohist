<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Mohist.Cli</RootNamespace>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>mo</ToolCommandName>
    <PackageId>Mohist.Cli</PackageId>
    <Description>Mohist command line interface.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="System.CommandLine" />
    <None Include="..\..\..\docs\README.md" Pack="true" PackagePath="\" />
    <Content Include="skill-data\**\*" CopyToOutputDirectory="PreserveNewest" Pack="true" PackagePath="skill-data/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <UsingTask TaskName="GenerateSkillManifest"
             TaskFactory="RoslynCodeTaskFactory"
             AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <ManifestPath ParameterType="System.String" Required="true" />
      <Version ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System.Diagnostics" />
      <Using Namespace="System.IO" />
      <Code Type="Fragment" Language="cs">
<![CDATA[
        string gitHash = "dev";
        try
        {
          using var process = new Process
          {
            StartInfo = new ProcessStartInfo
            {
              FileName = "git",
              Arguments = "rev-parse HEAD",
              UseShellExecute = false,
              RedirectStandardOutput = true,
              CreateNoWindow = true,
            }
          };
          process.Start();
          var output = process.StandardOutput.ReadToEnd().Trim();
          process.WaitForExit(5000);
          if (!string.IsNullOrWhiteSpace(output))
            gitHash = output;
        }
        catch { }

        Directory.CreateDirectory(Path.GetDirectoryName(ManifestPath)!);
        var json = "{\n  \"schemaVersion\": 1,\n  \"cliVersion\": \"" + Version + "\",\n  \"gitHash\": \"" + gitHash + "\",\n  \"skills\": [ \"mohist\", \"mohist-explore\" ]\n}\n";
        File.WriteAllText(ManifestPath, json);
]]>
      </Code>
    </Task>
  </UsingTask>

  <Target Name="GenerateSkillDataManifest" BeforeTargets="Build">
    <PropertyGroup>
      <_SkillDataManifestPath>$([System.IO.Path]::Combine('$(MSBuildThisFileDirectory)', 'skill-data', 'manifest.json'))</_SkillDataManifestPath>
    </PropertyGroup>
    <GenerateSkillManifest
      ManifestPath="$(_SkillDataManifestPath)"
      Version="$(Version)" />
  </Target>

</Project>
