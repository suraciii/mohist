{
  "name": "mohist",
  "version": "0.1.0",
  "description": "AI-powered issue workflow automation tool",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "mo": "./bin/mo",
    "mo-server": "./bin/mo-server"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start:server": "node bin/mo-server",
    "start:cli": "node bin/mo",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "automation",
    "ai",
    "workflow",
    "issue-management",
    "opencode",
    "developer-tools",
    "productivity"
  ],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/owner/mohist.git"
  },
  "bugs": {
    "url": "https://github.com/owner/mohist/issues"
  },
  "homepage": "https://github.com/owner/mohist#readme",
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "bin/",
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@agentclientprotocol/sdk": "^0.18.0",
    "@ai-sdk/anthropic": "^3.0.64",
    "@ai-sdk/openai": "^3.0.48",
    "ai": "^6.0.141",
    "better-sqlite3": "^12.8.0",
    "chalk": "^4.1.2",
    "commander": "^11.1.0",
    "hono": "^4.7.0",
    "@hono/node-server": "^1.13.0",
    "uuid": "^9.0.0",
    "yaml": "^2.8.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20.10.0",
    "@types/supertest": "^7.2.0",
    "@types/uuid": "^9.0.7",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "eslint": "^8.54.0",
    "supertest": "^7.2.2",
    "typescript": "^5.3.2",
    "vitest": "^1.0.4"
  }
}
