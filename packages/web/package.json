{
  "name": "mohist-web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "test:ci": "vitest run",
    "test:e2e": "playwright test -c playwright.config.ts",
    "test:a11y": "vitest run --config vitest.a11y.config.ts && playwright install --with-deps chromium && playwright test -c playwright.a11y.config.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
