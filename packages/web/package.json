{
  "name": "mohist-web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node ../../scripts/assert-web-build.mjs",
    "typecheck": "tsc -b",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "test:ci": "npm run check:fsd && npm run check:test-boundaries && vitest run",
    "test:duration": "npm run check:fsd && npm run check:test-boundaries && vitest run",
    "check:fsd": "node --import tsx ../../scripts/check-web-fsd-boundaries.ts",
    "check:test-boundaries": "node --import tsx ../../scripts/check-node-test-boundaries.ts --scope web",
    "test:browser": "playwright test -c playwright.config.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@fontsource-variable/geist": "^5.2.9",
    "@microsoft/signalr": "^10.0.0",
    "@tailwindcss/typography": "^0.5.19",
    "@tanstack/react-query": "^5.96.2",
    "@xyflow/react": "^12.11.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "dagre": "^0.8.5",
    "fuzzysort": "^3.1.0",
    "lucide-react": "^1.16.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.14.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.13.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.0",
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/dagre": "^0.7.54",
    "@types/node": "^25.9.3",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "jsdom": "^29.0.2",
    "msw": "^2.15.0",
    "tailwindcss": "^4.0.0",
    "typescript": "7.0.2",
    "vite": "^6.4.3",
    "vitest": "^4.1.10"
  },
  "optionalDependencies": {
    "lightningcss-linux-x64-gnu": "^1.32.0",
    "lightningcss-win32-x64-msvc": "^1.32.0"
  }
}
