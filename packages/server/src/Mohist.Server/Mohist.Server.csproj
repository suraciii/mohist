<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <RootNamespace>Mohist.Server</RootNamespace>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Google.Protobuf" />
    <PackageReference Include="Microsoft.Orleans.Sdk" />
    <PackageReference Include="Microsoft.Orleans.Server" />
    <PackageReference Include="Microsoft.Orleans.Reminders" />
    <PackageReference Include="Microsoft.Orleans.Reminders.AdoNet" />
    <PackageReference Include="Microsoft.Orleans.Persistence.AdoNet" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" />
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <PackageReference Include="YamlDotNet" />
    <PackageReference Include="EnvironmentAbstractions" />
    <PackageReference Include="CloudNative.CloudEvents" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" />
    <PackageReference Include="OpenTelemetry.Instrumentation.EntityFrameworkCore" />
    <PackageReference Include="Scrutor" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="EnvironmentAbstractions.BannedApiAnalyzer" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Mohist.Workflow.Definition\Mohist.Workflow.Definition.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Workflow/Services/Profiles/*.workflow.yaml" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Workflow/Services/Prompts/builtins/*.prompt" CopyToOutputDirectory="PreserveNewest" />
    <EmbeddedResource Include="Workflow/Services/Profiles/*.workflow.yaml" />
    <EmbeddedResource Include="Workflow/Services/Prompts/builtins/*.prompt" />
    <Content Include="Issue/Services/IssueTemplates/templates/*.md" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="BuildWebAssets" BeforeTargets="Build" Condition="'$(SkipWebBuild)' != 'true'">
    <Exec WorkingDirectory="$(MSBuildProjectDirectory)/../../../.." Command="npm run build -w packages/web" />
  </Target>

  <Target Name="CopyWebAssetsToOutput" AfterTargets="BuildWebAssets" BeforeTargets="Build">
    <ItemGroup>
      <WebDistFiles Include="$(MSBuildProjectDirectory)/../../../web/dist/**/*" />
    </ItemGroup>
    <Copy SourceFiles="@(WebDistFiles)" DestinationFiles="@(WebDistFiles->'$(OutDir)wwwroot/%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>

  <Target Name="CopyWebAssetsToPublish" AfterTargets="Publish">
    <ItemGroup>
      <WebDistFiles Include="$(MSBuildProjectDirectory)/../../../web/dist/**/*" />
    </ItemGroup>
    <Copy SourceFiles="@(WebDistFiles)" DestinationFiles="@(WebDistFiles->'$(PublishDir)wwwroot/%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>

</Project>
