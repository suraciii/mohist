<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <RootNamespace>Mohist.Server.ArchTests</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <SdkRoslynBinaryRoot>$(MSBuildToolsPath)/Roslyn/bincore</SdkRoslynBinaryRoot>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="TngTech.ArchUnitNET.xUnitV3" />
    <Reference Include="Microsoft.CodeAnalysis">
      <HintPath>$(MSBuildToolsPath)/Roslyn/bincore/Microsoft.CodeAnalysis.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="Microsoft.CodeAnalysis.CSharp">
      <HintPath>$(MSBuildToolsPath)/Roslyn/bincore/Microsoft.CodeAnalysis.CSharp.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <ProjectReference Include="..\..\src\Mohist.Server\Mohist.Server.csproj" />
    <ProjectReference Include="..\..\..\cli\Mohist.Cli\Mohist.Cli.csproj" />
    <ProjectReference Include="..\Mohist.Server.SpecTests\Mohist.Server.SpecTests.csproj" />
    <ProjectReference Include="..\Mohist.Server.UnitTests\Mohist.Server.UnitTests.csproj" />
    <ProjectReference Include="..\Mohist.Server.TestSupport\Mohist.Server.TestSupport.csproj" />
    <Reference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers">
      <HintPath>$(PkgMicrosoft_CodeAnalysis_BannedApiAnalyzers)/analyzers/dotnet/cs/Microsoft.CodeAnalysis.BannedApiAnalyzers.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="Microsoft.CodeAnalysis.CSharp.BannedApiAnalyzers">
      <HintPath>$(PkgMicrosoft_CodeAnalysis_BannedApiAnalyzers)/analyzers/dotnet/cs/Microsoft.CodeAnalysis.CSharp.BannedApiAnalyzers.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\src\Mohist.Server\**\*.cs">
      <LogicalName>ServerSources/%(RecursiveDir)%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\Mohist.Server.SpecTests\**\*.cs" Exclude="..\Mohist.Server.SpecTests\bin\**;..\Mohist.Server.SpecTests\obj\**">
      <LogicalName>TestSources/Mohist.Server.SpecTests/%(RecursiveDir)%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\Mohist.Server.UnitTests\**\*.cs" Exclude="..\Mohist.Server.UnitTests\bin\**;..\Mohist.Server.UnitTests\obj\**">
      <LogicalName>TestSources/Mohist.Server.UnitTests/%(RecursiveDir)%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\Mohist.Server.TestSupport\**\*.cs" Exclude="..\Mohist.Server.TestSupport\bin\**;..\Mohist.Server.TestSupport\obj\**">
      <LogicalName>TestSources/Mohist.Server.TestSupport/%(RecursiveDir)%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="*.cs">
      <LogicalName>TestSources/Mohist.Server.ArchTests/%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="spec-file-size-baseline.json">
      <LogicalName>SpecFileSizeBaseline.json</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="comment-reference-baseline.json">
      <LogicalName>CommentReferenceBaseline.json</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\..\..\..\eng\TestTime.cs">
      <LogicalName>TestSources/eng/TestTime.cs</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="SpecUnitMigrationLedger.json">
      <LogicalName>SpecUnitMigrationLedger.json</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="SpecUnitMigrationProvenance.json">
      <LogicalName>SpecUnitMigrationProvenance.json</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="SpecUnitMigrationPr388GitProof.txt">
      <LogicalName>SpecUnitMigrationPr388GitProof.txt</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\..\src\Mohist.Server\Mohist.Server.csproj">
      <LogicalName>ProductionProjects/Mohist.Server.csproj</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\..\..\cli\Mohist.Cli\Mohist.Cli.csproj">
      <LogicalName>ProductionProjects/Mohist.Cli.csproj</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\..\src\Mohist.Workflow.Definition\Mohist.Workflow.Definition.csproj">
      <LogicalName>ProductionProjects/Mohist.Workflow.Definition.csproj</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\..\..\..\eng\BannedSymbols.Product.txt">
      <LogicalName>BannedSymbols.Product.txt</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\..\..\..\eng\BannedSymbols.Tests.txt">
      <LogicalName>BannedSymbols.Tests.txt</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <Target Name="CopySdkRoslynForSemanticInventory" AfterTargets="Build">
    <Copy SourceFiles="$(SdkRoslynBinaryRoot)/Microsoft.CodeAnalysis.dll;$(SdkRoslynBinaryRoot)/Microsoft.CodeAnalysis.CSharp.dll"
          DestinationFolder="$(TargetDir)"
          SkipUnchangedFiles="false" />
  </Target>

</Project>
