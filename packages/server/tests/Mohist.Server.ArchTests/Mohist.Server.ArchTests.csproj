<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <RootNamespace>Mohist.Server.ArchTests</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <SdkRoslynBinaryRoot>$(MSBuildToolsPath)/Roslyn/bincore</SdkRoslynBinaryRoot>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="TngTech.ArchUnitNET.xUnitV3" />
    <Reference Include="Microsoft.CodeAnalysis">
      <HintPath>$(MSBuildToolsPath)/Roslyn/bincore/Microsoft.CodeAnalysis.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="Microsoft.CodeAnalysis.CSharp">
      <HintPath>$(MSBuildToolsPath)/Roslyn/bincore/Microsoft.CodeAnalysis.CSharp.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <ProjectReference Include="..\..\src\Mohist.Server\Mohist.Server.csproj" />
    <Reference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers">
      <HintPath>$(PkgMicrosoft_CodeAnalysis_BannedApiAnalyzers)/analyzers/dotnet/cs/Microsoft.CodeAnalysis.BannedApiAnalyzers.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="Microsoft.CodeAnalysis.CSharp.BannedApiAnalyzers">
      <HintPath>$(PkgMicrosoft_CodeAnalysis_BannedApiAnalyzers)/analyzers/dotnet/cs/Microsoft.CodeAnalysis.CSharp.BannedApiAnalyzers.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\src\Mohist.Server\**\*.cs"
                      Exclude="..\..\src\Mohist.Server\bin\**\*;..\..\src\Mohist.Server\obj\**\*">
      <LogicalName>ServerSources/%(RecursiveDir)%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\Mohist.Server.Tests\**\*.cs"
                      Exclude="..\Mohist.Server.Tests\bin\**\*;..\Mohist.Server.Tests\obj\**\*">
      <LogicalName>TestSources/Mohist.Server.Tests/%(RecursiveDir)%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\Mohist.Server.TestSupport\**\*.cs"
                      Exclude="..\Mohist.Server.TestSupport\bin\**\*;..\Mohist.Server.TestSupport\obj\**\*">
      <LogicalName>TestSources/Mohist.Server.TestSupport/%(RecursiveDir)%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="comment-reference-baseline.json">
      <LogicalName>CommentReferenceBaseline.json</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\..\src\Mohist.Server\Mohist.Server.csproj">
      <LogicalName>ProductionProjects/Mohist.Server.csproj</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\..\src\Mohist.Workflow.Definition\Mohist.Workflow.Definition.csproj">
      <LogicalName>ProductionProjects/Mohist.Workflow.Definition.csproj</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\..\..\..\eng\BannedSymbols.Product.txt">
      <LogicalName>BannedSymbols.Product.txt</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\..\..\..\eng\BannedSymbols.Tests.txt">
      <LogicalName>BannedSymbols.Tests.txt</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <Target Name="CopySdkRoslynForArchitectureRules" AfterTargets="Build">
    <Copy SourceFiles="$(SdkRoslynBinaryRoot)/Microsoft.CodeAnalysis.dll;$(SdkRoslynBinaryRoot)/Microsoft.CodeAnalysis.CSharp.dll"
          DestinationFolder="$(TargetDir)"
          SkipUnchangedFiles="false" />
  </Target>

</Project>
