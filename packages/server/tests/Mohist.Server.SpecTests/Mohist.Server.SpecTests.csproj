<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <RootNamespace>Mohist.Server.SpecTests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Orleans.TestingHost" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="TngTech.ArchUnitNET.xUnitV3" />
    <PackageReference Include="EnvironmentAbstractions" />
    <PackageReference Include="EnvironmentAbstractions.TestHelpers" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="System.Net.Http.Json" />
  </ItemGroup>


  <ItemGroup>
    <ProjectReference Include="..\..\src\Mohist.Server\Mohist.Server.csproj" />
    <ProjectReference Include="..\..\..\cli\Mohist.Cli\Mohist.Cli.csproj" />
  </ItemGroup>

  <Target Name="CopyTemplates" BeforeTargets="Build">
    <PropertyGroup>
      <_TemplatesDir>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\src\Mohist.Server\Issue\Services\IssueTemplates\templates'))</_TemplatesDir>
    </PropertyGroup>
    <ItemGroup>
      <_TemplateFiles Include="$(_TemplatesDir)\*.md" />
    </ItemGroup>
    <Copy
      SourceFiles="@(_TemplateFiles)"
      DestinationFolder="$(OutputPath)Issue\Services\IssueTemplates\templates\"
      SkipUnchangedFiles="true" />
  </Target>

  <Target Name="CopyCliSkillData" AfterTargets="Build">
    <PropertyGroup>
      <_CliProjectDir>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..\..\cli\Mohist.Cli'))</_CliProjectDir>
    </PropertyGroup>
    <ItemGroup>
      <_SkillDataFiles Include="$(_CliProjectDir)\skill-data\**\*" />
    </ItemGroup>
    <Copy
      SourceFiles="@(_SkillDataFiles)"
      DestinationFolder="$(OutputPath)skill-data\%(_SkillDataFiles.RecursiveDir)"
      SkipUnchangedFiles="true" />
  </Target>

</Project>
