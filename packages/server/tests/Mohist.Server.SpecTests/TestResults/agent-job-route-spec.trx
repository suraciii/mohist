          "GrainIdN0" INTEGER NOT NULL,
          "GrainIdN1" INTEGER NOT NULL,
          "GrainTypeHash" INTEGER NOT NULL,
          "GrainTypeString" TEXT NOT NULL,
          "GrainIdExtensionString" TEXT NULL,
