{
  "name": "mohist-runner",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "mohist-runner": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "postbuild": "node scripts/write-build-info.mjs",
    "dev": "tsx src/cli.ts",
    "start": "node dist/cli.js",
    "test": "vitest run",
    "test:run": "vitest run",
    "test:ci": "npm run typecheck:tests && npm run check:test-boundaries && npm run test:run",
    "check:test-boundaries": "node ../../scripts/check-node-test-boundaries.mjs --scope runner",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:tests": "tsc -p tsconfig.tests.json --noEmit"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "0.21.0",
    "@microsoft/signalr": "^10.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "tsx": "^4.20.0",
    "typescript": "^5.3.2",
    "vitest": "^4.1.10"
  }
}
