{
  "name": "crawlph-cli",
  "version": "0.1.0",
  "description": "AI-powered issue workflow automation tool",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "crawlph": "./bin/crawlph",
    "crawlph-server": "./bin/crawlph-server"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start:server": "node bin/crawlph-server",
    "start:cli": "node bin/crawlph",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "automation",
    "ai",
    "workflow",
    "issue-management",
    "opencode",
    "developer-tools",
    "productivity"
  ],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/owner/crawlph.git"
  },
  "bugs": {
    "url": "https://github.com/owner/crawlph/issues"
  },
  "homepage": "https://github.com/owner/crawlph#readme",
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "bin/",
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "better-sqlite3": "^12.8.0",
    "chalk": "^4.1.2",
    "commander": "^11.1.0",
    "express": "^4.18.2",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.0",
    "@types/supertest": "^7.2.0",
    "@types/uuid": "^9.0.7",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "eslint": "^8.54.0",
    "supertest": "^7.2.2",
    "typescript": "^5.3.2",
    "vitest": "^1.0.4"
  }
}
